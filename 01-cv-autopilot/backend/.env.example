# Base de données locale de dev (voir README.md pour la créer)
DATABASE_URL=postgresql+asyncpg://localhost/cv_autopilot_dev

# Génère avec : python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Réutilisé par les services d'onboarding (voir ../prototypes/)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Origines autorisées à appeler l'API depuis un navigateur (CORS). Format JSON.
# En prod, remplacer par l'URL réelle du frontend déployé.
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Chiffre les secrets par utilisateur (mots de passe IMAP, tokens Gmail) avant
# écriture en base. Génère avec :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Perdre cette clé rend tous les secrets déjà stockés illisibles -- la
# sauvegarder comme n'importe quel autre secret de production.
SECRET_ENCRYPTION_KEY=

# Bêta privée -- /auth/signup exige une invitation (table beta_invites)
# tant que true. Passer à false pour l'ouverture publique.
BETA_INVITE_ONLY=true

# Protège /admin/* (gestion des invitations). Génère avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
