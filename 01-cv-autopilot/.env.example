# Resend — canal email direct (le seul 100% automatique)
# Créer une clé sur https://resend.com puis coller ici. Ne jamais committer .env réel.
# Domaine à vérifier sur Resend : tensoratech.com (celui d'Erman, pas theknowhow.ae —
# c'est l'employeur, pas son domaine, et on n'utilise jamais l'email de l'employeur
# actuel pour postuler ailleurs).
RESEND_API_KEY=

# Adresse d'envoi par défaut (doit être vérifiée sur Resend). Si vide, le CLI
# utilise data-<client>/profile.json -> personal.email
FROM_EMAIL=ermanwilliantag@tensoratech.com

# Prototypes uniquement (prototypes/) — pas requis pour le CLI Phase 1/1.5.
# Clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optionnel — modèle par défaut si non précisé : anthropic/claude-sonnet-4.5
# Liste des modèles disponibles : https://openrouter.ai/models
OPENROUTER_MODEL=
